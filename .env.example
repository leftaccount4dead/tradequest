# Copy to `.env` for local development
# Production: set these in your host (e.g. Vercel → Settings → Environment Variables)

# PostgreSQL — use Neon (free): https://neon.tech
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Random secret for session cookies (use a long random string in production)
AUTH_SECRET="change-me-in-production"

# AI Coach — free Google Gemini key (one key serves all users)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash-lite"
# COACH_RATE_LIMIT_PER_HOUR=40
